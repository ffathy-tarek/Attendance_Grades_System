{
  "rewrites": [
    { "source": "/student", "destination": "/index.html" },
    { "source": "/student/:path*", "destination": "/index.html" },
    { "source": "/instructor", "destination": "/index.html" },
    { "source": "/instructor/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/forget-password", "destination": "/index.html" },
    { "source": "/request-email", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
